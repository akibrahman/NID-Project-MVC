@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Admin Dashboard</h2>
        <a class="btn btn-success" asp-controller="Admin" asp-action="CreateModerator">Create Moderator</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row">
        <!-- Total Moderators -->
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="stat-icon bg-primary-subtle text-primary">
                                <i class="bi bi-person-badge"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Total Moderators</h6>
                            <h2 class="mb-0 fw-bold">@Model.TotalModerators</h2>
                        </div>
                    </div>
                    <a asp-controller="Admin" asp-action="Moderators" class="stretched-link"></a>
                </div>
            </div>
        </div>

        <!-- Total Users -->
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="stat-icon bg-success-subtle text-success">
                                <i class="bi bi-people"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Total Users</h6>
                            <h2 class="mb-0 fw-bold">@Model.TotalUsers</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Users -->
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="stat-icon bg-warning-subtle text-warning">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Pending Users</h6>
                            <h2 class="mb-0 fw-bold">@Model.TotalPendingUsers</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.6rem;
    }
</style>