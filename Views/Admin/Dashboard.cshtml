@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row">
    <div class="col-md-12">
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Admin Dashboard</h4>
                <a class="btn btn-success btn-sm" asp-controller="Admin" asp-action="CreateModerator">Create Moderator</a>
            </div>
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                <h5>Moderators (@Model.Count())</h5>
                @if (!Model.Any())
                {
                    <p>No moderators created yet.</p>
                }
                else
                {
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var moderator in Model)
                            {
                                <tr>
                                    <td>@moderator.FullName</td>
                                    <td>@moderator.Email</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>