@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Moderators";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Moderators</h2>
        <div>
            <a class="btn btn-secondary" asp-controller="Admin" asp-action="Dashboard">Back to Dashboard</a>
            <a class="btn btn-success" asp-controller="Admin" asp-action="CreateModerator">Create Moderator</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (!Model.Any())
    {
        <p>No moderators created yet.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var moderator in Model)
                {
                    <tr>
                        <td>@moderator.FullName</td>
                        <td>@moderator.Email</td>
                        <td>
                            @if (moderator.IsBlocked)
                            {
                                <span class="badge bg-danger">Blocked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            @if (moderator.IsBlocked)
                            {
                                <form asp-action="UnblockModerator" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@moderator.Id" />
                                    <button type="submit" class="btn btn-success btn-sm">Unblock</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="BlockModerator" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@moderator.Id" />
                                    <button type="submit" class="btn btn-warning btn-sm">Block</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>