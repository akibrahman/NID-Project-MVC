@model CreateApplicationViewModel
@{
    ViewData["Title"] = "Apply for Edit";
}

<div class="container">
    <h2>Apply for Edit</h2>
    <p>Select the fields you want to change. You can make one application per month.</p>

    <form asp-action="CreateApplication" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @foreach (var (label, prop) in new[] {
            ("Full Name", "ChangeFullName"),
            ("Father's Name", "ChangeFatherName"),
            ("Mother's Name", "ChangeMotherName"),
            ("Date of Birth", "ChangeDateOfBirth"),
            ("Gender", "ChangeGender"),
            ("Nationality", "ChangeNationality"),
            ("Religion", "ChangeReligion"),
            ("Occupation", "ChangeOccupation"),
            ("Blood Group", "ChangeBloodGroup"),
            ("Present Address", "ChangePresentAddress"),
            ("Permanent Address", "ChangePermanentAddress"),
            ("Photo", "ChangePhoto")
        })
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="@prop" id="@prop" value="true" />
                <label class="form-check-label" for="@prop">@label</label>
            </div>
        }

        <button type="submit" class="btn btn-primary mt-3">Submit Application</button>
        <a asp-action="MyApplication" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>