@model ApplicationUser
@{
    ViewData["Title"] = "User Details";
    var returnTo = ViewBag.ReturnTo as string;
    var backAction = returnTo == "allusers" ? "AllUsers" : "PendingUsers";
}

<div class="container">
    <a asp-action="@backAction" asp-controller="Moderator" class="btn btn-secondary mb-3">
        &larr; Back
    </a>

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4>User Details</h4>
        </div>
        <div class="card-body">
            <!-- Photo section -->
            <div class="text-center mb-3">
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath" alt="User Photo" class="img-fluid rounded" style="max-width:150px; height:auto;" />
                }
                else
                {
                    <p>No photo uploaded</p>
                }
            </div>

            <!-- Details -->
            <dl class="row">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Father's Name</dt>
                <dd class="col-sm-9">@Model.FatherName</dd>

                <dt class="col-sm-3">Mother's Name</dt>
                <dd class="col-sm-9">@Model.MotherName</dd>

                <dt class="col-sm-3">Date of Birth</dt>
                <dd class="col-sm-9">@Model.DateOfBirth?.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-3">Gender</dt>
                <dd class="col-sm-9">@Model.Gender</dd>

                <dt class="col-sm-3">Blood Group</dt>
                <dd class="col-sm-9">@Model.BloodGroup</dd>

                <dt class="col-sm-3">Nationality</dt>
                <dd class="col-sm-9">@Model.Nationality</dd>

                <dt class="col-sm-3">Religion</dt>
                <dd class="col-sm-9">@Model.Religion</dd>

                <dt class="col-sm-3">Occupation</dt>
                <dd class="col-sm-9">@Model.Occupation</dd>

                <dt class="col-sm-3">Present Address</dt>
                <dd class="col-sm-9">@Model.PresentAddress</dd>

                <dt class="col-sm-3">Permanent Address</dt>
                <dd class="col-sm-9">@Model.PermanentAddress</dd>

                <dt class="col-sm-3">NID Number</dt>
                <dd class="col-sm-9">@(Model.NIDNumber ?? "N/A")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsBlocked)
                    {
                        <span class="badge bg-danger">Blocked</span>
                    }
                    else if (Model.IsApproved)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                </dd>
            </dl>
        </div>
    </div>
</div>